// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/core/db/client"
}

datasource db {
  provider = "postgresql"
}

enum DbBarRole {
  OWNER
  MANAGER
  STAFF

  @@map("BarRole")
}

enum DbRole {
  USER
  ADMIN

  @@map("Role")
}

enum DbSubscriptionPlan {
  FREE
  PRO

  @@map("SubscriptionPlan")
}

enum DbSubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  EXPIRED

  @@map("SubscriptionStatus")
}

enum DbTableStatus {
  FREE
  OCCUPIED

  @@map("TableStatus")
}

enum DbOrderStatus {
  OPEN
  CLOSED
  CANCELLED

  @@map("OrderStatus")
}

enum DbPaymentStatus {
  PENDING
  PARTIAL
  PAID

  @@map("PaymentStatus")
}

enum DbPaymentMethod {
  CASH
  CARD
  MIXED
  NONE

  @@map("PaymentMethod")
}

enum DbDeliveryStatus {
  PENDING
  PARTIAL
  SERVED

  @@map("DeliveryStatus")
}

enum DbAdjustmentType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("AdjustmentType")
}

enum DbAdjustmentTarget {
  ORDER
  ITEM

  @@map("AdjustmentTarget")
}

model DbOrderAdjustment {
  id        String             @id @default(uuid())
  orderId   String
  order     DbOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  target    DbAdjustmentTarget
  itemId    String?
  item      DbOrderItem?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      DbAdjustmentType
  value     Int
  reason    String?
  createdAt DateTime           @default(now())

  @@index([orderId])
  @@index([itemId])
  @@map("OrderAdjustment")
}

model DbUser {
  id             String            @id @default(uuid())
  email          String            @unique
  googleId       String?           @unique
  name           String
  photoUrl       String?
  active         Boolean           @default(true)
  role           DbRole            @default(USER)
  language       String            @default("es")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  memberships    DbBarMember[]
  shifts         DbShift[]
  shiftRequests  DbShiftExchange[] @relation("Requester")
  shiftApprovals DbShiftExchange[] @relation("Target")
  auditLogs      DbAdminAuditLog[] @relation("AdminAuditActor")
  timeEntries    DbTimeEntry[]     @relation("TimeEntrySubject")
  timeEntryEdits DbTimeEntry[]     @relation("TimeEntryActor")

  @@map("User")
}

model DbBar {
  id          String             @id @default(uuid())
  name        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     DbBarMember[]
  shifts      DbShift[]
  categories  DbCategory[]
  tables      DbTable[]
  orders      DbOrder[]
  printer     DbPrinterConfig?
  printJobs   DbPrintJob[]
  billing     DbBarSubscription?
  timeEntries DbTimeEntry[]
  timeSeals   DbTimeEntrySeal[]

  @@map("Bar")
}

model DbBarMember {
  id        String    @id @default(uuid())
  userId    String
  user      DbUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  barId     String
  bar       DbBar     @relation(fields: [barId], references: [id], onDelete: Cascade)
  role      DbBarRole @default(STAFF)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, barId])
  @@index([barId, deletedAt])
  @@map("BarMember")
}

model DbShift {
  id          String            @id @default(uuid())
  startTime   DateTime
  endTime     DateTime
  userId      String
  user        DbUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  barId       String
  bar         DbBar             @relation(fields: [barId], references: [id], onDelete: Cascade)
  notes       String?
  exchanges   DbShiftExchange[]
  timeEntries DbTimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([barId, startTime])
  @@index([userId, startTime])
  @@map("Shift")
}

model DbShiftExchange {
  id          String   @id @default(uuid())
  shiftId     String
  shift       DbShift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requesterId String
  requester   DbUser   @relation("Requester", fields: [requesterId], references: [id])
  targetId    String?
  target      DbUser?  @relation("Target", fields: [targetId], references: [id])
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([shiftId])
  @@index([requesterId])
  @@index([targetId])
  @@map("ShiftExchange")
}

model DbCategory {
  id        String      @id @default(uuid())
  barId     String
  bar       DbBar       @relation(fields: [barId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  products  DbProduct[]
  deletedAt DateTime?

  @@index([barId, deletedAt])
  @@map("Category")
}

model DbProduct {
  id            String        @id @default(uuid())
  name          String
  price         Int           @default(0)
  categoryId    String
  category      DbCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  currentStock  Int           @default(0)
  minStockAlert Int           @default(0)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  orderItems    DbOrderItem[]

  @@index([categoryId, deletedAt])
  @@map("Product")
}

model DbCategoryTemplate {
  id        String              @id @default(uuid())
  name      String
  icon      String?
  products  DbProductTemplate[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("CategoryTemplate")
}

model DbProductTemplate {
  id         String             @id @default(uuid())
  name       String
  price      Int                @default(0)
  categoryId String
  category   DbCategoryTemplate @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageUrl   String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("ProductTemplate")
}

model DbTable {
  id        String        @id @default(uuid())
  name      String
  status    DbTableStatus @default(FREE)
  barId     String
  bar       DbBar         @relation(fields: [barId], references: [id], onDelete: Cascade)
  orders    DbOrder[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("Table")
}

model DbOrder {
  id             String              @id @default(uuid())
  barId          String
  bar            DbBar               @relation(fields: [barId], references: [id], onDelete: Cascade)
  tableId        String?
  table          DbTable?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableName      String?
  status         DbOrderStatus       @default(OPEN)
  totalAmount    Int                 @default(0)
  amountPaidCash Int                 @default(0)
  amountPaidCard Int                 @default(0)
  items          DbOrderItem[]
  adjustments    DbOrderAdjustment[]
  paymentMethod  DbPaymentMethod     @default(NONE)
  notes          String?
  tipAmount      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([barId, status])
  @@index([barId, createdAt])
  @@index([tableId])
  @@map("Order")
}

model DbOrderItem {
  id               String              @id @default(uuid())
  orderId          String
  order            DbOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          DbProduct           @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  priceAtPurchase  Int
  paidQuantity     Int                 @default(0)
  paidQuantityCash Int                 @default(0)
  paidQuantityCard Int                 @default(0)
  servedQuantity   Int                 @default(0)
  paymentStatus    DbPaymentStatus     @default(PENDING)
  deliveryStatus   DbDeliveryStatus    @default(PENDING)
  paymentMethod    DbPaymentMethod     @default(NONE)
  notes            String?
  adjustments      DbOrderAdjustment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("OrderItem")
}

model DbPrinterConfig {
  id         String    @id @default(uuid())
  barId      String    @unique
  bar        DbBar     @relation(fields: [barId], references: [id], onDelete: Cascade)
  deviceKey  String    @default(uuid())
  ipAddress  String?
  port       Int       @default(8080)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("PrinterConfig")
}

enum DbPrintJobStatus {
  PENDING
  PRINTING
  PRINTED
  FAILED

  @@map("PrintJobStatus")
}

model DbPrintJob {
  id          String           @id @default(uuid())
  barId       String
  bar         DbBar            @relation(fields: [barId], references: [id], onDelete: Cascade)
  payload     Json
  status      DbPrintJobStatus @default(PENDING)
  attempts    Int              @default(0)
  error       String?
  createdAt   DateTime         @default(now())
  claimedAt   DateTime?
  completedAt DateTime?

  @@index([barId, status, createdAt])
  @@map("PrintJob")
}

model DbBarSubscription {
  id                   String               @id @default(uuid())
  barId                String               @unique
  bar                  DbBar                @relation(fields: [barId], references: [id], onDelete: Cascade)
  plan                 DbSubscriptionPlan   @default(FREE)
  status               DbSubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?              @unique
  stripeSubscriptionId String?              @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  manualPlan           DbSubscriptionPlan?
  manualGrantExpiresAt DateTime?
  manualGrantReason    String?
  manualGrantedById    String?
  manualGrantedAt      DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status])
  @@index([manualPlan])
  @@map("BarSubscription")
}

model DbTimeEntry {
  id           String       @id
  barId        String
  bar          DbBar        @relation(fields: [barId], references: [id], onDelete: Restrict)
  userId       String
  user         DbUser       @relation("TimeEntrySubject", fields: [userId], references: [id], onDelete: Restrict)
  userSnapshot Json
  shiftId      String?
  shift        DbShift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  type         String
  action       String
  occurredAt   DateTime
  recordedAt   DateTime
  workdayDate  DateTime     @db.Date
  source       String
  latitude     Float?
  longitude    Float?
  rootId       String
  supersedesId String?      @unique
  supersedes   DbTimeEntry? @relation("TimeEntryRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy DbTimeEntry? @relation("TimeEntryRevision")
  actorId      String
  actor        DbUser       @relation("TimeEntryActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason       String?
  sequence     BigInt
  prevHash     String
  hash         String

  @@unique([barId, sequence])
  @@index([rootId])
  @@index([barId, userId, workdayDate])
  @@index([barId, workdayDate])
  @@map("TimeEntry")
}

model DbTimeEntrySeal {
  id         String   @id @default(uuid())
  barId      String
  bar        DbBar    @relation(fields: [barId], references: [id], onDelete: Restrict)
  sealedDate DateTime @db.Date
  sequence   BigInt
  headHash   String
  createdAt  DateTime @default(now())

  @@unique([barId, sealedDate])
  @@index([barId, sealedDate])
  @@map("TimeEntrySeal")
}

model DbAdminAuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       DbUser   @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  targetLabel String?
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("AdminAuditLog")
}
