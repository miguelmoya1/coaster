// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/core/db/client"
}

datasource db {
  provider = "postgresql"
}

enum DbEstablishmentRole {
  OWNER
  MANAGER
  STAFF

  @@map("EstablishmentRole")
}

enum DbRole {
  USER
  ADMIN

  @@map("Role")
}

enum DbEstablishmentModule {
  TIME_TRACKING
  ORDERS
  INVENTORY

  @@map("EstablishmentModule")
}

enum DbSubscriptionPlan {
  FREE
  PRO

  @@map("SubscriptionPlan")
}

enum DbSubscriptionStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  EXPIRED

  @@map("SubscriptionStatus")
}

enum DbTableStatus {
  FREE
  OCCUPIED

  @@map("TableStatus")
}

enum DbOrderStatus {
  OPEN
  CLOSED
  CANCELLED

  @@map("OrderStatus")
}

enum DbPaymentStatus {
  PENDING
  PARTIAL
  PAID

  @@map("PaymentStatus")
}

enum DbPaymentMethod {
  CASH
  CARD
  MIXED
  NONE

  @@map("PaymentMethod")
}

enum DbDeliveryStatus {
  PENDING
  PARTIAL
  SERVED

  @@map("DeliveryStatus")
}

enum DbAdjustmentType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("AdjustmentType")
}

enum DbAdjustmentTarget {
  ORDER
  ITEM

  @@map("AdjustmentTarget")
}

model DbOrderAdjustment {
  id        String             @id @default(uuid())
  orderId   String
  order     DbOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  target    DbAdjustmentTarget
  itemId    String?
  item      DbOrderItem?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      DbAdjustmentType
  value     Int
  reason    String?
  createdAt DateTime           @default(now())

  @@index([orderId])
  @@index([itemId])
  @@map("OrderAdjustment")
}

model DbUser {
  id             String                  @id @default(uuid())
  email          String                  @unique
  googleId       String?                 @unique
  name           String
  photoUrl       String?
  active         Boolean                 @default(true)
  role           DbRole                  @default(USER)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  preferences    DbUserPreferences?
  memberships    DbEstablishmentMember[]
  shifts         DbShift[]
  shiftRequests  DbShiftExchange[]       @relation("Requester")
  shiftApprovals DbShiftExchange[]       @relation("Target")
  auditLogs      DbAdminAuditLog[]       @relation("AdminAuditActor")
  timeEntries    DbTimeEntry[]           @relation("TimeEntrySubject")
  timeEntryEdits DbTimeEntry[]           @relation("TimeEntryActor")

  @@map("User")
}

model DbEstablishment {
  id          String                       @id @default(uuid())
  name        String
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  members     DbEstablishmentMember[]
  shifts      DbShift[]
  categories  DbCategory[]
  tables      DbTable[]
  orders      DbOrder[]
  printer     DbPrinterConfig?
  printJobs   DbPrintJob[]
  billing     DbEstablishmentSubscription?
  settings    DbEstablishmentSettings?
  aiUsage     DbAiUsage[]
  pairings    DbPrinterPairing[]
  timeEntries DbTimeEntry[]

  @@map("Establishment")
}

model DbEstablishmentSettings {
  id              String                  @id @default(uuid())
  establishmentId String                  @unique
  establishment   DbEstablishment         @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  modules         DbEstablishmentModule[]
  configuredAt    DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("EstablishmentSettings")
}

/// A one-use code that turns a downloaded bridge into this establishment's bridge, so nobody has to
/// type an id or a device key into a console.
model DbPrinterPairing {
  id              String          @id @default(uuid())
  code            String          @unique
  establishmentId String
  establishment   DbEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  redeemedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([establishmentId])
  @@map("PrinterPairing")
}

model DbAiUsage {
  id              String          @id @default(uuid())
  establishmentId String
  establishment   DbEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  period          String
  messages        Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([establishmentId, period])
  @@map("AiUsage")
}

model DbUserPreferences {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      DbUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  language  String   @default("es")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("UserPreferences")
}

model DbEstablishmentMember {
  id              String              @id @default(uuid())
  userId          String
  user            DbUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishmentId String
  establishment   DbEstablishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  role            DbEstablishmentRole @default(STAFF)
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@unique([userId, establishmentId])
  @@index([establishmentId, deletedAt])
  @@map("EstablishmentMember")
}

model DbShift {
  id              String            @id @default(uuid())
  startTime       DateTime
  endTime         DateTime
  userId          String
  user            DbUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishmentId String
  establishment   DbEstablishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  notes           String?
  exchanges       DbShiftExchange[]
  timeEntries     DbTimeEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([establishmentId, startTime])
  @@index([userId, startTime])
  @@map("Shift")
}

model DbShiftExchange {
  id          String   @id @default(uuid())
  shiftId     String
  shift       DbShift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requesterId String
  requester   DbUser   @relation("Requester", fields: [requesterId], references: [id])
  targetId    String?
  target      DbUser?  @relation("Target", fields: [targetId], references: [id])
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@index([shiftId])
  @@index([requesterId])
  @@index([targetId])
  @@map("ShiftExchange")
}

model DbCategory {
  id              String          @id @default(uuid())
  establishmentId String
  establishment   DbEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  name            String
  icon            String?
  products        DbProduct[]
  deletedAt       DateTime?

  @@index([establishmentId, deletedAt])
  @@map("Category")
}

model DbProduct {
  id            String        @id @default(uuid())
  name          String
  price         Int           @default(0)
  categoryId    String
  category      DbCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  currentStock  Int           @default(0)
  minStockAlert Int           @default(0)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  orderItems    DbOrderItem[]

  @@index([categoryId, deletedAt])
  @@map("Product")
}

model DbCategoryTemplate {
  id        String              @id @default(uuid())
  name      String
  icon      String?
  products  DbProductTemplate[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("CategoryTemplate")
}

model DbProductTemplate {
  id         String             @id @default(uuid())
  name       String
  price      Int                @default(0)
  categoryId String
  category   DbCategoryTemplate @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageUrl   String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("ProductTemplate")
}

model DbTable {
  id              String          @id @default(uuid())
  name            String
  status          DbTableStatus   @default(FREE)
  establishmentId String
  establishment   DbEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orders          DbOrder[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("Table")
}

model DbOrder {
  id              String              @id @default(uuid())
  establishmentId String
  establishment   DbEstablishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  tableId         String?
  table           DbTable?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableName       String?
  status          DbOrderStatus       @default(OPEN)
  totalAmount     Int                 @default(0)
  amountPaidCash  Int                 @default(0)
  amountPaidCard  Int                 @default(0)
  items           DbOrderItem[]
  adjustments     DbOrderAdjustment[]
  paymentMethod   DbPaymentMethod     @default(NONE)
  notes           String?
  tipAmount       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([establishmentId, status])
  @@index([establishmentId, createdAt])
  @@index([tableId])
  @@map("Order")
}

model DbOrderItem {
  id               String              @id @default(uuid())
  orderId          String
  order            DbOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          DbProduct           @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  priceAtPurchase  Int
  paidQuantity     Int                 @default(0)
  paidQuantityCash Int                 @default(0)
  paidQuantityCard Int                 @default(0)
  servedQuantity   Int                 @default(0)
  paymentStatus    DbPaymentStatus     @default(PENDING)
  deliveryStatus   DbDeliveryStatus    @default(PENDING)
  paymentMethod    DbPaymentMethod     @default(NONE)
  notes            String?
  adjustments      DbOrderAdjustment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("OrderItem")
}

model DbPrinterConfig {
  id              String          @id @default(uuid())
  establishmentId String          @unique
  establishment   DbEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  deviceKey       String          @default(uuid())
  ipAddress       String?
  port            Int             @default(8080)
  lastSeenAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("PrinterConfig")
}

enum DbPrintJobStatus {
  PENDING
  PRINTING
  PRINTED
  FAILED

  @@map("PrintJobStatus")
}

model DbPrintJob {
  id              String           @id @default(uuid())
  establishmentId String
  establishment   DbEstablishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  payload         Json
  status          DbPrintJobStatus @default(PENDING)
  attempts        Int              @default(0)
  error           String?
  createdAt       DateTime         @default(now())
  claimedAt       DateTime?
  completedAt     DateTime?

  @@index([establishmentId, status, createdAt])
  @@map("PrintJob")
}

model DbEstablishmentSubscription {
  id                   String               @id @default(uuid())
  establishmentId      String               @unique
  establishment        DbEstablishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  plan                 DbSubscriptionPlan   @default(FREE)
  status               DbSubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?              @unique
  stripeSubscriptionId String?              @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  canceledAt           DateTime?
  manualPlan           DbSubscriptionPlan?
  manualGrantExpiresAt DateTime?
  manualGrantReason    String?
  manualGrantedById    String?
  manualGrantedAt      DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status])
  @@index([manualPlan])
  @@map("EstablishmentSubscription")
}

model DbTimeEntry {
  id              String          @id
  establishmentId String
  establishment   DbEstablishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  userId          String
  user            DbUser          @relation("TimeEntrySubject", fields: [userId], references: [id], onDelete: Restrict)
  userSnapshot    Json
  shiftId         String?
  shift           DbShift?        @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  type            String
  action          String
  occurredAt      DateTime
  recordedAt      DateTime
  workdayDate     DateTime        @db.Date
  source          String
  latitude        Float?
  longitude       Float?
  rootId          String
  supersedesId    String?         @unique
  supersedes      DbTimeEntry?    @relation("TimeEntryRevision", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy    DbTimeEntry?    @relation("TimeEntryRevision")
  actorId         String
  actor           DbUser          @relation("TimeEntryActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason          String?
  sequence        BigInt
  prevHash        String
  hash            String

  @@unique([establishmentId, sequence])
  @@index([rootId])
  @@index([establishmentId, userId, workdayDate])
  @@index([establishmentId, workdayDate])
  @@map("TimeEntry")
}

model DbAdminAuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       DbUser   @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  targetLabel String?
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("AdminAuditLog")
}
