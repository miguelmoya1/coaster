# Fichit: el registro de jornada. Sin URL o sin clave la integración queda
# apagada y Coaster funciona igual, sin sincronizar nada. Una clave por entorno:
# la de beta nunca puede tocar producción.
#
# Estas dos son el respaldo: si se configuran desde el panel de administración,
# lo del panel manda y estas se ignoran.
FICHIT_API_URL=""
FICHIT_API_KEY=""

# Con la que se cifra lo que guarda el panel. 32 bytes en base64:
#   openssl rand -base64 32
# Sin ella el panel no puede guardar la clave de Fichit, y falla en vez de
# escribirla en claro.
SETTINGS_ENCRYPTION_KEY=""

REDIS_URL=""

TRUST_PROXY_HOPS=""

# Closed beta: when "true", only emails on the BetaTester table can open a new account
BETA_ALLOWLIST_ENABLED=""
