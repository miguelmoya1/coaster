{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "lib": ["ESNext", "ESNext.Temporal"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@coaster/admin": ["./src/admin/index.ts"],
      "@coaster/ai": ["./src/ai/index.ts"],
      "@coaster/auth": ["./src/auth/index.ts"],
      "@coaster/catalogue": ["./src/catalogue/index.ts"],
      "@coaster/establishment-members": ["./src/establishment-members/index.ts"],
      "@coaster/establishment-subscription": ["./src/establishment-subscription/index.ts"],
      "@coaster/establishments": ["./src/establishments/index.ts"],
      "@coaster/categories": ["./src/categories/index.ts"],
      "@coaster/core": ["./src/core/index.ts"],
      "@coaster/core/db": ["./src/core/db/index.ts"],
      "@coaster/email": ["./src/email/index.ts"],
      "@coaster/media": ["./src/media/index.ts"],
      "@coaster/orders": ["./src/orders/index.ts"],
      "@coaster/printer": ["./src/printer/index.ts"],
      "@coaster/products": ["./src/products/index.ts"],
      "@coaster/shift-exchanges": ["./src/shift-exchanges/index.ts"],
      "@coaster/shifts": ["./src/shifts/index.ts"],
      "@coaster/stats": ["./src/stats/index.ts"],
      "@coaster/stripe": ["./src/stripe/index.ts"],
      "@coaster/tables": ["./src/tables/index.ts"],
      "@coaster/time-tracking": ["./src/time-tracking/index.ts"],
      "@coaster/users": ["./src/users/index.ts"],
      "@coaster/websockets": ["./src/websockets/index.ts"]
    }
  }
}
