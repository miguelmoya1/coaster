# Variables que lee la API en Go (internal/config/config.go). Cópialo a .env: lo leen
# scripts/dev.sh, para lanzarla en el anfitrión, y el servicio coaster-api de docker compose, que
# pone los suyos en DATABASE_URL, REDIS_URL, PORT, PUBLIC_DIR y PUBLIC_URL.

# Obligatorias: sin ellas no arranca.
DATABASE_URL="postgres://admin:admin@localhost:5432/coaster"
AUTH_JWT_SECRET=""
PRINTER_JWT_SECRET=""

# En la imagen, PORT es 8080 y los binarios del puente están en /app/public; en el anfitrión,
# public/ de esta carpeta.
PORT="3000"
PUBLIC_URL="http://localhost:3000"
NODE_ENV="development"

# Sin REDIS_URL no hay caché ni bus de realtime compartido.
REDIS_URL=""

GOOGLE_CLIENT_ID=""
FRONTEND_URL="http://localhost:4200"
# Vacío en desarrollo = http://localhost:4200.
CORS_ORIGINS=""
TRUST_PROXY_HOPS=""
BETA_ALLOWLIST_ENABLED=""
# "false" para no consultar Have I Been Pwned al registrarse.
PWNED_PASSWORDS_ENABLED=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PRO_LEGACY=""
PRO_BASE_PRICE_CENTS="1999"
PRO_INCLUDED_SEATS="10"
PRO_EXTRA_SEAT_PRICE_CENTS="200"

# Email: sin RESEND_API_KEY los emails se escriben en el log.
RESEND_API_KEY=""
EMAIL_FROM=""

# Subida de imágenes (Google Cloud Storage).
MEDIA_BUCKET=""

# IA
AI_GATEWAY_API_KEY=""
AI_MONTHLY_MESSAGES=""
AI_TRIAL_MONTHLY_MESSAGES=""
