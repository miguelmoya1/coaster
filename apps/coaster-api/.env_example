# Variables que lee la API en Go (internal/config/config.go). Son las mismas que las de Nest
# (apps/api/.env), así que no hace falta escribirlas a mano:
#   - con docker compose, el servicio coaster-api ya carga apps/api/.env;
#   - para lanzarla en el anfitrión, apps/coaster-api/scripts/env-local.sh crea apps/coaster-api/.env a
#     partir de apps/api/.env, y apps/coaster-api/scripts/dev.sh la arranca en el 3001.

# Obligatorias: sin ellas no arranca, igual que Nest.
DATABASE_URL="postgres://admin:admin@localhost:5432/coaster"
AUTH_JWT_SECRET=""
PRINTER_JWT_SECRET=""

# Solo de Go. En la imagen son 8080 y /app/public; en el anfitrión, lo que pone env-local.sh.
PORT="3001"
PUBLIC_DIR="../api/public"
PUBLIC_URL="http://localhost:3001"
NODE_ENV="development"

# Sin REDIS_URL no hay caché ni bus de realtime compartido, como en Nest.
REDIS_URL=""

GOOGLE_CLIENT_ID=""
FRONTEND_URL="http://localhost:4200"
# Vacío en desarrollo = http://localhost:4200.
CORS_ORIGINS=""
TRUST_PROXY_HOPS=""
BETA_ALLOWLIST_ENABLED=""
# "false" para no consultar Have I Been Pwned al registrarse.
PWNED_PASSWORDS_ENABLED=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PRO_LEGACY=""
PRO_BASE_PRICE_CENTS="1999"
PRO_INCLUDED_SEATS="10"
PRO_EXTRA_SEAT_PRICE_CENTS="200"

# Email: sin RESEND_API_KEY los emails se escriben en el log.
RESEND_API_KEY=""
EMAIL_FROM=""

# Subida de imágenes (Google Cloud Storage).
MEDIA_BUCKET=""

# IA
AI_GATEWAY_API_KEY=""
AI_MONTHLY_MESSAGES=""
AI_TRIAL_MONTHLY_MESSAGES=""
