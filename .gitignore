# Dependencies and build output, in any app
node_modules
dist
coverage
*.tsbuildinfo

# Environment files are never committed; the examples are
.env*
!.env_example
.vercel

# apps/web installs with npm from its own package-lock.json; a stray pnpm/yarn
# lockfile makes Vercel switch package manager
pnpm-lock.yaml
yarn.lock

# Editors and OS
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.DS_Store
Thumbs.db

# Worktrees que crea Claude Code para sus subagentes
.claude/worktrees/
