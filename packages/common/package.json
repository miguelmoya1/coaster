{
  "name": "@coaster/common",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm i -g typescript",
    "build": "tsc && tsc -p tsconfig.esm.json && node ./scripts/write-esm-marker.mjs",
    "test": "vitest run"
  },
  "module": "./dist/esm/index.js",
  "sideEffects": false
}
